{
  "name": "desktop",
  "version": "1.0.0",
  "private": true,
  "description": "My Electron application description",
  "keywords": [],
  "license": "MIT",
  "author": "patty",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "../../scripts/run-with-node.sh ../../node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "package": "../../scripts/run-with-node.sh ../../node_modules/@electron-forge/cli/dist/electron-forge.js package",
    "make": "../../scripts/run-with-node.sh ../../node_modules/@electron-forge/cli/dist/electron-forge.js make",
    "publish": "../../scripts/run-with-node.sh ../../node_modules/@electron-forge/cli/dist/electron-forge.js publish",
    "lint": "oxfmt --check . && bun run lint:code",
    "lint:code": "../../node_modules/.bin/eslint . --max-warnings 0",
    "dev": "../../scripts/run-with-node.sh ../../node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "check-types": "../../node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "../../scripts/run-with-node.sh --experimental-strip-types --test ./tests/unit.test.js ./tests/packages/*.test.mts",
    "test:integration": "../../scripts/run-with-node.sh --test ./tests/integration.test.js",
    "test:e2e": "bun run build && ../../scripts/run-with-node.sh ../../node_modules/playwright/cli.js test"
  },
  "dependencies": {
    "@moritzbrantner/electron-commands": "file:packages/electron-commands",
    "@moritzbrantner/electron-documents": "file:packages/electron-documents",
    "@moritzbrantner/electron-json-store": "file:packages/electron-json-store",
    "@moritzbrantner/electron-preferences": "file:packages/electron-preferences",
    "@moritzbrantner/electron-window-state": "file:packages/electron-window-state",
    "@repo/auth-contract": "workspace:*",
    "@repo/game-catalog": "workspace:*",
    "@repo/game-contracts": "workspace:*",
    "@repo/game-engine": "workspace:*",
    "@repo/game-poker": "workspace:*",
    "@repo/game-session": "workspace:*",
    "@repo/game-tcg": "workspace:*",
    "@repo/game-uno": "workspace:*",
    "@repo/multiplayer-contract": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "electron-squirrel-startup": "^1.0.1",
    "motion": "^12.35.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^2.1.1",
    "@playwright/test": "^1.58.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.1.1",
    "electron": "43.1.0",
    "playwright": "^1.58.2",
    "typescript": "~7.0.2",
    "vite": "^8.0.8"
  },
  "packageManager": "bun@1.3.12",
  "productName": "desktop"
}
