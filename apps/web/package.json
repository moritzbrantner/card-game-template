{
  "name": "next-template",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js application with auth, admin examples, and Drizzle/Postgres persistence",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev-with-test-db.sh",
    "dev:app": "bun ./scripts/next-websocket-server.ts --dev",
    "build": "next build && bunx tsup ./scripts/next-websocket-server.ts --format esm --platform node --target node24 --out-dir .next/custom-server && mv .next/custom-server/next-websocket-server.js .next/custom-server/next-websocket-server.mjs",
    "build:gh-pages": "bun ./scripts/build-gh-pages.mjs",
    "build:staging": "bun run build:gh-pages",
    "start": "../../scripts/run-with-node.sh ./.next/custom-server/next-websocket-server.mjs --prod",
    "lint": "oxfmt --check . '!packages/**' '!vendor/**' && bun run lint:code",
    "lint:code": "eslint . --max-warnings 0 --ignore-pattern 'packages/**' --ignore-pattern 'vendor/**'",
    "lint:fix": "oxfmt --write . '!packages/**' '!vendor/**'",
    "packages:lint": "bun ./scripts/run-workspace-command.mjs lint",
    "packages:check-types": "bun ./scripts/run-workspace-command.mjs check-types",
    "packages:typecheck": "bun run packages:check-types",
    "packages:test:unit": "bun ./scripts/run-workspace-command.mjs test:unit",
    "packages:test": "bun run packages:test:unit",
    "check-types": "tsc --noEmit",
    "typecheck": "bun run check-types",
    "ci:verify": "bun run lint && bun run check-types && bun run packages:lint && bun run packages:check-types && bun run packages:test:unit && bun run db:check && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration",
    "test:e2e": "../../scripts/run-with-node.sh ../../node_modules/playwright/cli.js test",
    "test:e2e:setup": "./scripts/ci/bootstrap-e2e-db.sh",
    "test:e2e:teardown": "./scripts/ci/bootstrap-e2e-db.sh --teardown",
    "test:e2e:auth": "../../scripts/run-with-node.sh ../../node_modules/playwright/cli.js test tests/e2e/authentication.spec.ts",
    "db:seed:test-users": "bun ./scripts/seed-test-users.ts",
    "test:unit": "vitest run",
    "checks:nightly": "./scripts/ci/tier-nightly.sh",
    "checks:beta": "./scripts/ci/tier-beta.sh",
    "checks:main": "./scripts/ci/tier-main.sh",
    "checks:all": "./scripts/ci/tier-all.sh",
    "db:schema:generate": "bun ./scripts/generate-db-schema.ts",
    "jobs:work": "bun ./scripts/run-jobs.ts --watch"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@base-ui/react": "^1.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@moritzbrantner/app-pack": "workspace:*",
    "@moritzbrantner/app-pack-react": "workspace:*",
    "@moritzbrantner/card-games": "workspace:*",
    "@moritzbrantner/storytelling": "workspace:*",
    "@moritzbrantner/ui": "workspace:*",
    "@next/mdx": "^16.2.3",
    "@react-email/components": "1.0.12",
    "@react-three/fiber": "^9.5.0",
    "@remotion/player": "^4.0.447",
    "@repo/auth-contract": "workspace:*",
    "@repo/game-catalog": "workspace:*",
    "@repo/game-contracts": "workspace:*",
    "@repo/game-engine": "workspace:*",
    "@repo/game-phase-10": "workspace:*",
    "@repo/game-poker": "workspace:*",
    "@repo/game-session": "workspace:*",
    "@repo/game-tcg": "workspace:*",
    "@repo/game-uno": "workspace:*",
    "@repo/multiplayer-contract": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.35.2",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.8.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.447",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "swapy": "^1.0.5",
    "tailwind-merge": "^3.4.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^7.5.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@unlighthouse/cli": "^0.17.7",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.0.2",
    "puppeteer": "^24.40.0",
    "react-email": "6.0.0",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.3.12"
}
