# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55433/next_template?schema=public"
POSTGRES_PORT="55433"

# Ephemeral compose-managed Postgres used by `bun run dev`
DEV_DB_PORT="55435"
DEV_DB_NAME="next_template"
DEV_DB_USER="postgres"
DEV_DB_PASSWORD="postgres"
DEV_DB_CONTAINER_NAME="web-dev-postgres"
DEV_DB_HOST_CONTAINER_NAME="web-dev-postgres-host"
DEV_DB_NETWORK_MODE="auto"
DB_BOOTSTRAP_TIMEOUT_SECONDS="90"

# App/auth base URLs
AUTH_SECRET="replace-with-a-long-random-secret"
SITE_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Account lifecycle email delivery
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@example.com"
MAILPIT_BASE_URL="http://127.0.0.1:8025"

# Profile image object storage
PROFILE_IMAGE_STORAGE_BUCKET="profile-images"
PROFILE_IMAGE_STORAGE_REGION="us-east-1"
PROFILE_IMAGE_STORAGE_ENDPOINT="http://127.0.0.1:9000"
PROFILE_IMAGE_STORAGE_ACCESS_KEY_ID="minioadmin"
PROFILE_IMAGE_STORAGE_SECRET_ACCESS_KEY="minioadmin"
PROFILE_IMAGE_PUBLIC_BASE_URL="http://127.0.0.1:9000/profile-images"
PROFILE_IMAGE_STORAGE_FORCE_PATH_STYLE="true"

# Local MinIO object storage for uploads
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET="profile-images"
MINIO_API_PORT="9000"
MINIO_CONSOLE_PORT="9001"

# Observability and internal jobs
LOG_LEVEL="debug"
INTERNAL_CRON_SECRET="replace-with-an-internal-cron-secret"
ANALYTICS_ENABLED="true"
