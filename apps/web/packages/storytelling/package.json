{
  "name": "@moritzbrantner/storytelling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./remotion": {
      "types": "./src/remotion.tsx",
      "import": "./src/remotion.tsx"
    },
    "./three": {
      "types": "./src/three.tsx",
      "import": "./src/three.tsx"
    }
  },
  "scripts": {
    "lint": "oxfmt --check . && bun run lint:imports && bun run lint:code",
    "lint:imports": "bun ../../scripts/verify-package-imports.mjs ./src @/ next/ next-intl",
    "lint:code": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "bun run check-types",
    "test:unit": "cd ../.. && vitest run packages/storytelling/tests/storytelling.test.tsx",
    "test": "bun run test:unit"
  },
  "dependencies": {
    "motion": "^12.35.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.4.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "^4.0.379",
    "three": "^0.184.0"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.379",
    "three": "^0.184.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "remotion": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
