{
  "name": "@moritzbrantner/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./button-variants": {
      "types": "./src/button-variants.ts",
      "import": "./src/button-variants.ts"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "lint": "oxfmt --check . && bun run lint:imports && bun run lint:code",
    "lint:imports": "bun ../../scripts/verify-package-imports.mjs ./src @/ next/",
    "lint:code": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "bun run check-types",
    "test:unit": "cd ../.. && vitest run packages/ui/tests/ui.test.tsx",
    "test": "bun run test:unit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.35.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
