{
  "name": "@moritzbrantner/app-pack-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    }
  },
  "scripts": {
    "lint": "oxfmt --check . && bun run lint:imports && bun run lint:code",
    "lint:imports": "bun ../../scripts/verify-package-imports.mjs ./src @/ next/",
    "lint:code": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "bun run check-types",
    "test:unit": "cd ../.. && vitest run packages/app-pack-react/tests/app-pack-react.test.tsx",
    "test": "bun run test:unit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
