{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "reset-project": "../../scripts/run-with-node.sh ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios --port 4002",
    "web": "expo start --web --port 4002",
    "lint": "oxfmt --check . && bun run lint:code",
    "lint:code": "eslint . --max-warnings 0",
    "dev": "expo start --port 4002",
    "build": "expo export --platform web",
    "check-types": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit:contracts": "../../scripts/run-with-node.sh --test ./tests/unit.test.js",
    "test:unit:components": "vitest run tests/components.test.tsx",
    "test:unit": "bun run test:unit:contracts && bun run test:unit:components",
    "test:integration": "../../scripts/run-with-node.sh --test ./tests/integration.test.js",
    "test:e2e": "playwright test",
    "test:e2e:serve": "CI=1 expo start --web --port 4002"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@repo/auth-contract": "workspace:*",
    "@repo/game-catalog": "workspace:*",
    "@repo/game-contracts": "workspace:*",
    "@repo/game-engine": "workspace:*",
    "@repo/game-phase-10": "workspace:*",
    "@repo/game-poker": "workspace:*",
    "@repo/game-session": "workspace:*",
    "@repo/game-tcg": "workspace:*",
    "@repo/game-uno": "workspace:*",
    "@repo/multiplayer-contract": "workspace:*",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "motion": "^12.35.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.0.2",
    "react-native-reanimated": "~4.4.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.17",
    "playwright": "^1.58.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.3.12",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
