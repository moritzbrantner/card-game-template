{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "start": "expo start",
    "reset-project": "../../scripts/run-with-node.sh ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios --port 4002",
    "web": "expo start --web --port 4002",
    "lint": "../../scripts/run-with-node.sh ../../node_modules/eslint-plugin-react/node_modules/eslint/bin/eslint.js .",
    "dev": "expo start --port 4002",
    "build": "expo export --platform web",
    "test": "../../scripts/run-with-node.sh -e \"console.log('No automated tests configured for this app yet.')\"",
    "test:unit": "../../scripts/run-with-node.sh --test ./tests/unit.test.js",
    "test:integration": "../../scripts/run-with-node.sh --test ./tests/integration.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@repo/auth-contract": "workspace:*",
    "@repo/game-catalog": "workspace:*",
    "@repo/game-contracts": "workspace:*",
    "@repo/game-engine": "workspace:*",
    "@repo/game-poker": "workspace:*",
    "@repo/game-session": "workspace:*",
    "@repo/game-tcg": "workspace:*",
    "@repo/game-uno": "workspace:*",
    "@repo/multiplayer-contract": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "motion": "^12.35.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.85.1",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.17",
    "eslint": "^10.2.0",
    "eslint-config-expo": "~55.0.0",
    "playwright": "^1.58.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
