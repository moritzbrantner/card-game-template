{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformAutomerge": true,
  "extends": [
    "github>moritzbrantner/coding-agent-conventions"
  ],
  "packageRules": [
    {
      "description": "Keep the mobile runtime on the installed Expo SDK 55 compatibility line; update this rule when upgrading Expo.",
      "matchFileNames": [
        "apps/mobile/package.json"
      ],
      "matchPackageNames": [
        "react-native"
      ],
      "allowedVersions": "0.83.10"
    },
    {
      "description": "Keep React and its test renderer aligned with Expo SDK 55.",
      "matchFileNames": [
        "apps/mobile/package.json"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-test-renderer"
      ],
      "allowedVersions": "19.2.0",
      "groupName": "Expo SDK 55 React runtime"
    },
    {
      "description": "Expo SDK packages follow the installed Expo SDK 55; move them only as part of a deliberate SDK upgrade and update this rule then.",
      "matchFileNames": [
        "apps/mobile/package.json"
      ],
      "matchPackageNames": [
        "expo",
        "expo-*"
      ],
      "allowedVersions": "<56"
    },
    {
      "description": "Electron Forge makers and plugins share types with @electron-forge/cli; move them to a new major together.",
      "matchPackageNames": [
        "@electron-forge/**"
      ],
      "groupName": "Electron Forge"
    }
  ]
}
