{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/desktop",
    "apps/web/packages/*",
    "packages/*"
  ],
  "scripts": {
    "build": "AUTH_SECRET=\"${AUTH_SECRET:-local-build-secret-local-build-secret}\" DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:55435/next_template?schema=public}\" turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "setup:promotion-branches": "bash ./scripts/setup-promotion-branches.sh",
    "manage:subtree-secrets": "bash ./scripts/manage-subtree-secrets.sh",
    "setup:subtree-remotes": "bash ./scripts/setup-subtree-remotes.sh",
    "sync:subtrees": "bash ./scripts/setup-subtree-remotes.sh && bash ./scripts/sync-subtrees.sh",
    "lint": "turbo run lint && bun run lint:repo",
    "lint:repo": "eslint scripts tests playwright.config.ts --max-warnings 0",
    "typecheck": "bun run check-types",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "./scripts/run-with-node.sh --test ./tests/unit/*.test.mjs && turbo run test:unit",
    "test:integration": "bash ./scripts/run-integration-tests.sh",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "benchmark": "bun scripts/run-build-benchmark.mjs",
    "format": "oxfmt --write .",
    "check-types": "turbo run check-types",
    "backup:build": "bash -lc 'cd apps/web.backup && bun run build'",
    "backup:check-types": "bash -lc 'cd apps/web.backup && bun run check-types'",
    "backup:test:unit": "bash -lc 'cd apps/web.backup && bun run test:unit'",
    "backup:test:integration": "bash -lc 'cd apps/web.backup && bun run test:integration'",
    "backup:test:e2e": "bash -lc 'cd apps/web.backup && bun run test:e2e'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "oxfmt": "^0.46.0",
    "turbo": "^2.9.18",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild"
  ]
}
